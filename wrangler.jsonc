{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "car-recond-japan",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "build": {
    "command": "node gemini-site/scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./gemini-site/dist-cloudflare",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "gemini-site/owner-worker.mjs",
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "20261021",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTENT_STORE",
        "class_name": "ShowroomContent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "content-v1",
      "new_sqlite_classes": [
        "ShowroomContent"
      ]
    }
  ]
}
